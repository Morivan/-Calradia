C4Container
    title Рисунок 3 — Диаграмма контейнеров системы (C4 Level 2)

    Person(user, "Пользователь", "Просматривает каталог и оформляет заказы")

    System_Boundary(sys, "Кузница Кальрадия — VPS Debian 11") {
        Container(spa, "React SPA", "React 19 / TypeScript", "Каталог, комплекты, панель администратора")
        Container(nginx, "Nginx 1.18", "Reverse Proxy", "Раздаёт статику dist/ и проксирует /api/, /admin/")
        Container(api, "Django App", "Django 5.2 + DRF", "REST API, бизнес-логика, интеграции ВК и Telegram")
        ContainerDb(db, "База данных", "SQLite WAL", "Товары, заказы, клиенты, отзывы, задачи, допуски")
    }

    System_Ext(vk,   "ВКонтакте",  "Callback API — события группы")
    System_Ext(tg,   "Telegram",   "Bot API — уведомления мастерам")
    System_Ext(smtp, "SMTP",       "Email-уведомления о срочных заказах")

    Rel(user,  nginx, "Открывает сайт",        "HTTPS :443")
    Rel(nginx, spa,   "Отдаёт статику",         "HTTP")
    Rel(nginx, api,   "Проксирует запросы",      "/api/, /admin/")
    Rel(api,   db,    "Читает / записывает",     "ORM")
    Rel(api,   tg,    "Отправляет уведомления",  "HTTPS Bot API")
    Rel(api,   smtp,  "Отправляет email",        "SMTP :587")
    Rel(vk,    api,   "Входящие webhook-события","HTTPS POST")

    UpdateLayoutConfig($c4ShapeInRow="4", $c4BoundaryInRow="1")
